
# ==========================================
# GNCILink - Main Website Configuration
# Domain: gncipampanga.com
# ==========================================

# Disable directory listing and MultiViews
Options -Indexes -MultiViews

# Standalone GNCI error pages work without PHP or database access.
ErrorDocument 400 /errors/400.html
ErrorDocument 401 /errors/401.html
ErrorDocument 403 /errors/403.html
ErrorDocument 404 /errors/404.html
ErrorDocument 500 /errors/500.html

# /admin/dashboard is an application route despite the older directory shim.
<IfModule mod_dir.c>
    <If "%{REQUEST_URI} == '/admin/dashboard'">
        DirectorySlash Off
    </If>
</IfModule>

# Stable root worker URL; PHP supplies the deployment version without build tooling.
<IfModule mod_mime.c>
    AddType application/manifest+json .webmanifest
</IfModule>
<Files "manifest.json">
    ForceType application/manifest+json
</Files>
<Files "admin-manifest.json">
    ForceType application/manifest+json
</Files>
<IfModule mod_headers.c>
    Header onsuccess unset X-Content-Type-Options
    Header onsuccess unset X-Frame-Options
    Header onsuccess unset Content-Security-Policy
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Content-Security-Policy "frame-ancestors 'self'; object-src 'none'; base-uri 'self'"
    <FilesMatch "^((admin-)?manifest\.json|offline\.html)$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
</IfModule>

# Protect server configuration
<Files ".user.ini">
    Require all denied
</Files>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /
    # Apply before routing, on every hostname (including staging and direct IPs).
    RewriteRule (^|/)(app|config|storage|vendor|cache|tests|database|scripts|docs|sql|\.git|\.agents|\.codex|\.aws)(/|$) - [F,END,NC]
    RewriteRule (^|/)(\.env[^/]*|\.ht[^/]*|\.user\.ini|secrets(\.php)?|config(\.php)?|composer\.(json|lock)|package(-lock)?\.json|Dockerfile[^/]*|docker-compose[^/]*|[^/]+\.(sql|bak|log|ini|md))$ - [F,END,NC]
    RewriteRule ^uploads/.*\.(php[0-9]*|phtml|pht|phar|cgi|pl|py|sh|shtml|html?|js)([./]|$) - [F,END,NC]
    RewriteRule ^service-worker\.js$ service-worker.php [END]
    RewriteRule ^admin/service-worker\.js$ admin/service-worker.php [END]

    # Administrative aliases stay inside the Admin PWA's /admin/ scope.
    # Execute original files directly (dashboard also has an old directory shim).
    RewriteRule ^admin/account-password/?$ admin/account-password.php [END]
    RewriteRule ^admin/activity-logs/?$ admin/logs.php [END]
    RewriteRule ^admin/admin-help/?$ admin/help.php [END]
    RewriteRule ^admin/change-password/?$ admin/change-password.php [END]
    RewriteRule ^admin/content-editor/?$ admin/content-edit.php [END]
    RewriteRule ^admin/dashboard/?$ admin/admin-dash.php [END]
    RewriteRule ^admin/enrollment-steps/?$ admin/enrollment-steps.php [END]
    RewriteRule ^admin/facebook-integration/?$ admin/facebook-integration.php [END]
    RewriteRule ^admin/forgot-password/?$ admin/forgot-password.php [END]
    RewriteRule ^admin/login/?$ admin/login.php [END]
    RewriteRule ^admin/logout/?$ admin/auth/logout.php [END]
    RewriteRule ^admin/manage-announcements/?$ admin/announcement.php [END]
    RewriteRule ^admin/manage-events/?$ admin/events.php [END]
    RewriteRule ^admin/manage-facebook-posts/?$ admin/facebook-posts.php [END]
    RewriteRule ^admin/manage-news/?$ admin/news.php [END]
    RewriteRule ^admin/manage-student-achievements/?$ admin/student-achievements.php [END]
    RewriteRule ^admin/manage-users/?$ admin/users.php [END]
    RewriteRule ^admin/reset-password/?$ admin/reset-password.php [END]
    RewriteRule ^admin/settings/?$ admin/settings.php [END]
    RewriteRule ^admin/submissions/?$ admin/submissions.php [END]
    RewriteRule ^admin/verify-login/?$ admin/auth/verify-otp.php [END]

    # ==========================================
    # 1. MAIN DOMAIN SECURITY
    # ==========================================

    # Prevent access to subdomain folders
    RewriteCond %{HTTP_HOST} ^(?:(?:www\.)?gncipampanga\.com|admin\.gncipampanga\.com|admin\.localhost)(?::[0-9]+)?$ [NC]
    RewriteRule ^(cba|clinic|library|osa)\.gncipampanga\.com(/|$) - [F,END,NC]



    # ==========================================
    # 2. REDIRECT .PHP TO CLEAN URL
    # Routing also supports local Docker hosts (including their port).
    # ==========================================

    # Redirect index.php to homepage
    # Explicit short browser URLs. Keep in sync with includes/browser-routes.php.
    RewriteCond %{HTTP_HOST} ^(?:(?:www\.)?gncipampanga\.com|admin\.gncipampanga\.com|admin\.localhost|localhost|127\.0\.0\.1)(?::[0-9]+)?$ [NC]
    RewriteRule ^alumni/?$ "pages/alumni.php" [END]

    RewriteCond %{HTTP_HOST} ^(?:(?:www\.)?gncipampanga\.com|admin\.gncipampanga\.com|admin\.localhost|localhost|127\.0\.0\.1)(?::[0-9]+)?$ [NC]
