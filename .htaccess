    RewriteRule ^account-password/?$ "admin/account-password.php" [END]

    RewriteCond %{HTTP_HOST} ^(?:(?:www\.)?gncipampanga\.com|admin\.gncipampanga\.com|admin\.localhost|localhost|127\.0\.0\.1)(?::[0-9]+)?$ [NC]
    RewriteRule ^verify-login/?$ "admin/auth/verify-otp.php" [END]

    RewriteCond %{HTTP_HOST} ^(?:(?:www\.)?gncipampanga\.com|admin\.gncipampanga\.com|admin\.localhost|localhost|127\.0\.0\.1)(?::[0-9]+)?$ [NC]
    RewriteRule ^logout/?$ "admin/auth/logout.php" [END]


    RewriteCond %{HTTP_HOST} ^(?:(?:www\.)?gncipampanga\.com|admin\.gncipampanga\.com|admin\.localhost|localhost|127\.0\.0\.1)(?::[0-9]+)?$ [NC]
    RewriteRule ^manage-student-achievements/?$ "admin/student-achievements.php" [END]

    RewriteCond %{HTTP_HOST} ^(?:(?:www\.)?gncipampanga\.com|admin\.gncipampanga\.com|admin\.localhost|localhost|127\.0\.0\.1)(?::[0-9]+)?$ [NC]
    RewriteRule ^facebook-integration/?$ "admin/facebook-integration.php" [END]

    RewriteCond %{HTTP_HOST} ^(?:(?:www\.)?gncipampanga\.com|admin\.gncipampanga\.com|admin\.localhost|localhost|127\.0\.0\.1)(?::[0-9]+)?$ [NC]
    RewriteRule ^enrollment-steps/?$ "admin/enrollment-steps.php" [END]



    RewriteCond %{HTTP_HOST} ^(?:(?:www\.)?gncipampanga\.com|admin\.gncipampanga\.com|admin\.localhost|localhost|127\.0\.0\.1)(?::[0-9]+)?$ [NC]
    RewriteRule ^programs/([a-z0-9-]+)/?$ pages/academics/college/program.php [END]
    RewriteCond %{HTTP_HOST} ^(?:(?:www\.)?gncipampanga\.com|admin\.gncipampanga\.com|admin\.localhost|localhost|127\.0\.0\.1)(?::[0-9]+)?$ [NC]
    RewriteRule ^departments/([a-z0-9-]+)/?$ pages/academics/college/college-department.php [END]

    # Redirect index.php to homepage
    RewriteCond %{HTTP_HOST} ^(?:(?:www\.)?gncipampanga\.com|admin\.gncipampanga\.com|admin\.localhost|localhost|127\.0\.0\.1)(?::[0-9]+)?$ [NC]
    RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
    RewriteCond %{THE_REQUEST} \s/+index\.php[\s?] [NC]
    RewriteRule ^index\.php$ / [R=302,L,NC]

    # Redirect page.php to /page
    RewriteCond %{HTTP_HOST} ^(?:(?:www\.)?gncipampanga\.com|admin\.gncipampanga\.com|admin\.localhost|localhost|127\.0\.0\.1)(?::[0-9]+)?$ [NC]
    RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
    RewriteCond %{THE_REQUEST} \s/+[^\s?]+\.php[\s?] [NC]
    RewriteCond %{REQUEST_URI} !^/(admin|api|chatbot|components|includes|config|tests|database)(/|$) [NC]
    RewriteCond %{REQUEST_URI} !^/pages/academics/college/(program|college-department)\.php$ [NC]
    RewriteRule ^(.+)\.php$ /$1 [R=302,L,NC]


    # ==========================================
    # 3. HOMEPAGE ROUTING
    # ==========================================

    RewriteCond %{HTTP_HOST} ^(?:(?:www\.)?gncipampanga\.com|admin\.gncipampanga\.com|admin\.localhost|localhost|127\.0\.0\.1)(?::[0-9]+)?$ [NC]
    RewriteRule ^$ index.php [END]


    # ==========================================
    # 4. EXISTING ROOT FILES AND DIRECTORIES
    # ==========================================

    RewriteCond %{HTTP_HOST} ^(?:(?:www\.)?gncipampanga\.com|admin\.gncipampanga\.com|admin\.localhost|localhost|127\.0\.0\.1)(?::[0-9]+)?$ [NC]
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [END]


    # ==========================================
    # 5. EXTENSIONLESS PHP PAGES
    # ==========================================

    # Keep the program identifier in the path. PHP reads it from REQUEST_URI.
    RewriteCond %{HTTP_HOST} ^(?:(?:www\.)?gncipampanga\.com|admin\.gncipampanga\.com|admin\.localhost|localhost|127\.0\.0\.1)(?::[0-9]+)?$ [NC]
    RewriteRule ^pages/academics/college/program/[a-z0-9-]+/?$ pages/academics/college/program.php [END]

    RewriteCond %{HTTP_HOST} ^(?:(?:www\.)?gncipampanga\.com|admin\.gncipampanga\.com|admin\.localhost|localhost|127\.0\.0\.1)(?::[0-9]+)?$ [NC]
    RewriteRule ^pages/academics/college/college-department/[a-z0-9-]+/?$ pages/academics/college/college-department.php [END]

    RewriteCond %{HTTP_HOST} ^(?:(?:www\.)?gncipampanga\.com|admin\.gncipampanga\.com|admin\.localhost|localhost|127\.0\.0\.1)(?::[0-9]+)?$ [NC]
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^(.+)$ $1.php [END]


    # Unknown paths use the server's normal 404 response.

</IfModule>
